{
	"name": "pi-extensions",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "YMS-QC private pi extension monorepo: vendored upstream packages (patched) + own assets",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"format": "biome format --write .",
		"lint": "biome lint .",
		"biome:check": "biome check .",
		"check:boundaries": "node ./scripts/check-extension-boundaries.mjs",
		"typecheck": "node ./scripts/run-typechecks.mjs",
		"build": "npm --workspaces --if-present run build",
		"test": "node ./scripts/run-tests.mjs",
		"stack-checks": "node ./scripts/run-stack-checks.mjs",
		"check": "node ./scripts/run-checks.mjs",
		"precommit": "npm run biome:check && npm run typecheck",
		"prepare": "node .husky/install.mjs",
		"changeset": "changeset",
		"changeset:status": "changeset status --verbose",
		"version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
		"publish-packages": "changeset publish"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@changesets/cli": "3.0.0",
		"@earendil-works/pi-agent-core": "0.84.2",
		"@earendil-works/pi-ai": "0.84.2",
		"@earendil-works/pi-coding-agent": "0.84.2",
		"@earendil-works/pi-tui": "0.84.2",
		"@types/node": "^26.2.0",
		"concurrently": "^10.0.5",
		"husky": "9.1.7",
		"npm-check-updates": "23.0.2",
		"typebox": "^1.3.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"pi": {
		"extensions": [
			"./packages/stack/pi-telegram/index.ts",
			"./packages/stack/pi-automode/extensions/auto-mode.ts",
			"./packages/stack/pi-hermes-memory/src/index.ts"
		],
		"skills": [
			"./packages/stack/pi-telegram/skills"
		]
	}
}
