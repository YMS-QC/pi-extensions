{
  "name": "pi-extensions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "YMS-QC private pi extension monorepo: vendored upstream packages (patched) + own assets",
  "workspaces": ["packages/*", "packages/stack/*"],
  "pi": {
    "extensions": [
      "./packages/stack/pi-telegram/index.ts",
      "./packages/stack/pi-automode/extensions/auto-mode.ts",
      "./packages/stack/pi-hermes-memory/src/index.ts"
    ],
    "skills": ["./packages/stack/pi-telegram/skills"]
  }
}
